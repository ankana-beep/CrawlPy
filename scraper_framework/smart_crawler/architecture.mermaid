flowchart TD
    %% High-level smart crawler architecture.

    subgraph Input["1. Input"]
        CLI["CLI<br/>smart_crawler.cli"]
        Seeds["Seed URLs<br/>CLI args or seeds.txt"]
        Options["CrawlOptions<br/>limits, browser, robots,<br/>workflow, Mongo collections"]
    end

    subgraph CrawlControl["2. Crawl Control"]
        Crawler["SmartCrawler"]
        Frontier["CrawlFrontier<br/>queue, seen, visited,<br/>same-domain rules, priority URLs"]
        Guards["Safety Guards<br/>robots.txt, skip login/captcha,<br/>skip static assets, rate limit"]
    end

    subgraph Fetch["3. Page Access"]
        HTTP["HTTP Fetch<br/>curl_cffi"]
        SSLFallback["SSL Fallback<br/>default CA -> system CA"]
        BrowserFallback["Browser Fallback<br/>Playwright when HTTP SSL fails"]
        BrowserRender["Browser Render<br/>Playwright for forms, app shells,<br/>low-text pages"]
    end

    subgraph Extract["4. Extraction"]
        GenericExtract["GenericExtractor<br/>HTML, JSON, XML, CSV,<br/>PDF/Excel metadata or text"]
        PageData["ExtractedPage<br/>text, links, tables, forms,<br/>files, feeds, sitemaps, APIs"]
        Discoveries["Discovered URLs<br/>queued back into frontier"]
    end

    subgraph Permit["5. Permit Intelligence"]
        Objective["PermitObjectiveExtractor<br/>score permit relevance"]
        StandardRecords["Standardized Permit Records<br/>permit number, type, dates,<br/>address, parcel, contractor,<br/>valuation, confidence"]
        Workflow["Permit Workflow<br/>safe date fill, search click,<br/>pagination, detail pages,<br/>network JSON extraction"]
    end

    subgraph Output["6. Persistence"]
        Artifact["Crawl Artifact<br/>debug evidence, optional"]
        Fingerprint["Record Identity<br/>record_key + record_fingerprint"]
        Mongo["MongoDB"]
        PermitCollection["Permit Collections<br/>building_permits__domain"]
        ArtifactCollection["Artifact Collections<br/>permit_crawl_artifacts__domain"]
        FailureCollection["Failure Collections<br/>smart_crawl_failures__domain"]
    end

    CLI --> Seeds --> Options --> Crawler
    Crawler --> Frontier
    Frontier --> Guards
    Guards --> HTTP

    HTTP --> SSLFallback
    SSLFallback -- "HTTP works" --> GenericExtract
    SSLFallback -- "SSL still fails" --> BrowserFallback
    BrowserFallback --> GenericExtract

    GenericExtract --> PageData
    PageData --> Discoveries --> Frontier
    PageData --> Objective

    Objective --> StandardRecords
    PageData -- "permit search page or form" --> Workflow
    Workflow --> StandardRecords
    Workflow --> Discoveries

    PageData -- "needs rendering" --> BrowserRender
    BrowserRender --> GenericExtract

    StandardRecords --> Fingerprint
    Fingerprint --> Mongo
    Mongo --> PermitCollection

    PageData --> Artifact
    Artifact --> Mongo
    Mongo --> ArtifactCollection

    Guards -- "blocked or failed" --> FailureCollection
    HTTP -- "non-SSL failure after retries" --> FailureCollection
    BrowserFallback -- "browser also fails" --> FailureCollection
    Workflow -- "workflow failure" --> FailureCollection

    classDef main fill:#e8f3ff,stroke:#3b82f6,color:#111827
    classDef data fill:#ecfdf5,stroke:#10b981,color:#111827
    classDef store fill:#fff7ed,stroke:#f97316,color:#111827
    classDef warn fill:#fef2f2,stroke:#ef4444,color:#111827

    class Crawler,Frontier,HTTP,BrowserFallback,BrowserRender,GenericExtract,Objective,Workflow main
    class Seeds,Options,PageData,Discoveries,StandardRecords,Fingerprint,Artifact data
    class Mongo,PermitCollection,ArtifactCollection,FailureCollection store
    class Guards,SSLFallback warn
